# E-commerce Agent Framework Environment Configuration
# Copy this file to .env and fill in your actual values

# === LLM Configuration ===
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === Database Configuration ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SESSION_TTL=86400

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Recommended production-like local setup: PostgreSQL is durable, Redis is cache.
STORAGE_BACKEND=hybrid
SESSION_STORAGE=hybrid
INGESTION_STORAGE=postgres

# === Platform Chat Adapters ===

# Xiaohongshu (小红书)
XIAOHONGSHU_APP_ID=your_xiaohongshu_app_id
XIAOHONGSHU_APP_SECRET=your_xiaohongshu_app_secret
XIAOHONGSHU_WEBHOOK_TOKEN=your_webhook_token
XIAOHONGSHU_MERCHANT_ID=your_merchant_id
XIAOHONGSHU_API_BASE_URL=https://api.xiaohongshu.com

# Taobao (淘宝)
TAOBAO_APP_KEY=your_taobao_app_key
TAOBAO_APP_SECRET=your_taobao_app_secret
TAOBAO_SESSION_KEY=your_session_key

# JD (京东)
JD_APP_KEY=your_jd_app_key
JD_APP_SECRET=your_jd_app_secret

# === Server Configuration ===
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# === Logging ===
LOG_LEVEL=INFO

# === Document Processing ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_DOCUMENTS_PER_INGESTION=100

# === Retrieval Configuration ===
SIMILARITY_TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.3

# === Uncertainty Detection ===
UNCERTAINTY_RETRIEVAL_THRESHOLD=0.3
UNCERTAINTY_QUERY_THRESHOLD=0.6
UNCERTAINTY_OVERALL_THRESHOLD=0.4

# === LLM Generation ===
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=500
LLM_TIMEOUT=30
