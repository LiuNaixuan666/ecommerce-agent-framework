{
  "manifest_version": 3,
  "name": "E-commerce Agent PoC",
  "version": "0.1.0",
  "description": "Browser extension PoC for extracting product context and sending it to a local FastAPI backend.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "E-commerce Agent PoC"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
